# =============================================================================
# POS System - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# LAN IP of the host device (where Docker runs)
# Set to 'auto' to auto-detect, or specify manually (e.g., 192.168.1.50)
LAN_IP=auto

# LAN CIDR for firewall rules (e.g., 192.168.1.0/24)
LAN_CIDR=192.168.1.0/24

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Strong random passwords (use: openssl rand -base64 32)
DB_ROOT_PASSWORD=change_me_root_password_32_chars_min
DB_APP_PASSWORD=change_me_app_password_32_chars_min

# -----------------------------------------------------------------------------
# Authentication (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_jwt_secret_48_chars_min

# -----------------------------------------------------------------------------
# Business Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Business type: 'grocery' (abarrotes) or 'restaurant' (restaurante)
BUSINESS_TYPE=restaurant

# Timezone (Colombia)
TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# FDE (Factura Electrónica DIAN) Configuration
# -----------------------------------------------------------------------------
# PAC Provider: 'tecnodata' | 'facturacion_electronica_co' | 'sfe'
FDE_PAC_PROVIDER=tecnodata

# API Keys from your PAC provider (get from PAC portal)
TECNODATA_API_KEY=your_pac_api_key_here
FACTURACION_ELECTRONICA_CO_API_KEY=your_fe_api_key_here
SFE_API_KEY=your_sfe_api_key_here

# Company NIT (without verification digit, e.g., 900123456)
COMPANY_NIT=900123456

# Company Information (for invoice generation)
COMPANY_NAME=MI EMPRESA SAS
COMPANY_ADDRESS=Calle 123 #45-67
COMPANY_CITY=BOGOTA
COMPANY_DEPARTMENT=CUNDINAMARCA
COMPANY_PHONE=+57 1 2345678
COMPANY_EMAIL=facturacion@miempresa.com

# Test mode (true for DIAN test environment, false for production)
FDE_TEST_MODE=true

# DIAN Resolution (from your DIAN authorization) - configure via UI after first deploy
# FDE_RESOLUTION_NUMBER=18760000001
# FDE_RESOLUTION_DATE=2024-01-15
# FDE_PREFIX=POS
# FDE_RANGE_START=1
# FDE_RANGE_END=999999
# FDE_VALID_FROM=2024-01-15
# FDE_VALID_UNTIL=2025-01-15

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Backup time (24h format)
BACKUP_TIME=02:00

# Retention days
BACKUP_RETENTION_DAYS=30

# Encrypt backups at rest (optional)
BACKUP_ENCRYPT=false
BACKUP_ENCRYPT_KEY=your_32_char_encryption_key_here

# -----------------------------------------------------------------------------
# Optional: Offsite backup (rclone)
# -----------------------------------------------------------------------------
# RCLONE_REMOTE=nas:pos-backups

# =============================================================================
# DO NOT MODIFY BELOW - Generated by deploy script
# =============================================================================
# LAN_IP_DETECTED=